{
  "name": "@kubohiroya/turbowarp-jotai-adapter",
  "version": "0.3.1",
  "description": "TurboWarp adapter blocks for describing Jotai atom registry, actions, and state bridge JSON.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-jotai-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-jotai-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-jotai-adapter/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "jotai",
    "state",
    "atom",
    "bridge",
    "adapter",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "assets/",
    "dist/",
    "docs/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "exports": {
    "./jotai-bridge": {
      "types": "./dist/jotai-bridge.d.ts",
      "import": "./dist/jotai-bridge.js"
    },
    "./dist/turbowarp-jotai-adapter.js": "./dist/turbowarp-jotai-adapter.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.3.2",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.6.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-extension-data-editor": "^0.2.1"
  },
  "unpkg": "./dist/turbowarp-jotai-adapter.js",
  "jsdelivr": "./dist/turbowarp-jotai-adapter.js",
  "gitHead": "d9bc81ddccb0eb24b5f5fc0f0c312d61d2e9d7db",
  "x-turbowarp-source": {
    "revision": "d9bc81ddccb0eb24b5f5fc0f0c312d61d2e9d7db",
    "revisionRole": "base-commit",
    "sourceState": "local-release-overlay"
  }
}
